# Copie ce fichier en « .env » et remplis les trois valeurs.
# .env ne doit JAMAIS partir sur GitHub (il est ignoré par .gitignore).

# Le sous-domaine qui pointe (enregistrement DNS A) vers l'IP du VPS.
ECOUTE_DOMAINE=ecoute.mon-domaine.fr

# Le mot de passe demandé sur la page (choisis-le, pas trop court).
ECOUTE_MOT_DE_PASSE=change-moi

# Le jeton que le Mac présente au relais (le même dans l'installeur du Mac).
ECOUTE_JETON_SOURCE=XoV7lWwom1U979YiWFItDD6HNIX5mgEh
